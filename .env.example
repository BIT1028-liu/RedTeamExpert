# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，真实密钥不会进入 git；本模板不含任何真实密钥

# ---- 智谱 GLM（必填）----
# 开放平台：https://open.bigmodel.cn
YOUR_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Tavily 联网搜索（必填）----
# 获取地址：https://app.tavily.com
TAVILY_API_KEY=

# ---- 阿里云 OSS（使用 FastAPI 后端上传图片/文件时必填）----
# 控制台：https://oss.console.aliyun.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：外网 endpoint，例如 oss-cn-hangzhou.aliyuncs.com；留空则由 region 推导
#OSS_ENDPOINT=

# ---- 前端开发服务器（CORS 白名单，多个用逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- LangSmith 追踪（可选，不需要则删掉 LANGSMITH_TRACING 或设为 false）----
# https://smith.langchain.com
#LANGSMITH_API_KEY=
#LANGSMITH_TRACING=true
#LANGSMITH_PROJECT=
